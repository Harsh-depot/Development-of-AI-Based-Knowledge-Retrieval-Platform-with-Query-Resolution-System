# ==============================================================================
# AI-Powered Intelligent Query Resolution System (Infosys Internship Project)
# Total Budget: $0.00 (Zero paid API keys, no credit card required)
# ==============================================================================

# 1. Multi-Agent LLM Orchestration (Free Tier)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_free_tier_key_here
# Optional free fallback key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (Groq Cloud Free Tier)
GROQ_MEMORY_MODEL=llama-3.1-8b-instant
GROQ_UNDERSTANDING_MODEL=llama-3.1-8b-instant
GROQ_CLARIFICATION_MODEL=llama-3.3-70b-versatile
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GOOGLE_FALLBACK_MODEL=gemini-2.5-flash

# 2. Vector Database (Qdrant)
# Qdrant Cloud 1GB Free Cluster (https://cloud.qdrant.io)
# Leave QDRANT_URL empty or set to ":memory:" / "./qdrant_storage" to run 100% locally on disk!
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# 3. Local CPU Embeddings & Reranker ($0.00, runs locally on CPU)
# FastEmbed model for 384-dimensional dense vectors
FASTEMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# FlashRank cross-encoder model for Stage-2 precision reranking
FLASHRANK_MODEL_NAME=ms-marco-MiniLM-L-6-v2

# 4. Relational Storage & Analytics
# Free PostgreSQL at Neon.tech / Supabase.
# If left empty, the system automatically falls back to local SQLite at sqlite:///./query_system.db
DATABASE_URL=sqlite:///./query_system.db

# 5. RAG & Retrieval Thresholds
RETRIEVAL_TOP_K=15
RERANK_TOP_K=4
CONFIDENCE_THRESHOLD=0.40
CHUNK_SIZE=800
CHUNK_OVERLAP=120
